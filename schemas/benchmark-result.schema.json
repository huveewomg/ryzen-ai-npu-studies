{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/npu-embeddings/benchmark-result.schema.json",
  "title": "NPU embedding benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recorded_at_utc",
    "model",
    "execution",
    "workload",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "source_model",
        "source_revision",
        "precision",
        "quantization_granularity",
        "metadata_filename",
        "metadata_sha256"
      ],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_model": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 7},
        "precision": {"enum": ["fp32", "dynamic-int8"]},
        "quantization_granularity": {"enum": ["none", "per-tensor", "per-channel"]},
        "metadata_filename": {"type": ["string", "null"]},
        "metadata_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "available_providers",
        "session_providers",
        "require_npu",
        "npu_verified",
        "assignment",
        "session_options",
        "npu_cache"
      ],
      "properties": {
        "requested": {"enum": ["cpu", "npu"]},
        "available_providers": {"type": "array", "items": {"type": "string"}},
        "session_providers": {"type": "array", "items": {"type": "string"}},
        "require_npu": {"type": "boolean"},
        "npu_verified": {"type": "boolean"},
        "assignment": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "report_file": {"type": "string"},
            "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "total_nodes": {"type": "integer", "minimum": 1},
            "npu_nodes": {"type": "integer", "minimum": 1},
            "cpu_nodes": {"type": "integer", "minimum": 0},
            "npu_node_coverage": {"type": "number", "minimum": 0, "maximum": 1},
            "npu_devices": {"type": "array", "items": {"type": "string"}},
            "npu_subgraphs": {"type": "integer", "minimum": 1}
          },
          "required": [
            "report_file",
            "report_sha256",
            "total_nodes",
            "npu_nodes",
            "cpu_nodes",
            "npu_node_coverage",
            "npu_devices",
            "npu_subgraphs"
          ]
        },
        "session_options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_mode",
            "intra_op_num_threads",
            "inter_op_num_threads"
          ],
          "properties": {
            "execution_mode": {"const": "ORT_SEQUENTIAL"},
            "intra_op_num_threads": {"type": "integer", "minimum": 0},
            "inter_op_num_threads": {"type": "integer", "minimum": 0}
          }
        },
        "npu_cache": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["cache_key", "present_before_session"],
              "properties": {
                "cache_key": {"type": "string", "minLength": 1},
                "present_before_session": {"type": "boolean"}
              }
            },
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"npu_verified": {"const": true}}},
          "then": {
            "properties": {
              "requested": {"const": "npu"},
              "require_npu": {"const": true},
              "assignment": {"type": "object"}
            }
          }
        },
        {
          "if": {
            "required": ["requested"],
            "properties": {"requested": {"const": "npu"}}
          },
          "then": {
            "properties": {
              "require_npu": {"const": true},
              "npu_verified": {"const": true},
              "assignment": {"type": "object"}
            }
          }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_size",
        "sequence_length",
        "warmup_iterations",
        "timed_iterations",
        "repeat",
        "input_kind",
        "input_file",
        "input_sha256",
        "text_prefix"
      ],
      "properties": {
        "batch_size": {"type": "integer", "minimum": 1},
        "sequence_length": {"type": "integer", "minimum": 1},
        "warmup_iterations": {"type": "integer", "minimum": 1},
        "timed_iterations": {"type": "integer", "minimum": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "input_kind": {
          "enum": ["fixed-shape synthetic microbenchmark", "tokenizer-backed text"]
        },
        "input_file": {"type": ["string", "null"]},
        "input_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "text_prefix": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_creation_ms", "inference_only", "end_to_end"],
      "properties": {
        "session_creation_ms": {"type": "number", "exclusiveMinimum": 0},
        "inference_only": {"$ref": "#/$defs/latency"},
        "end_to_end": {"anyOf": [{"$ref": "#/$defs/latency"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencies_ms",
        "mean_ms",
        "standard_deviation_ms",
        "median_ms",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "throughput_docs_per_second"
      ],
      "properties": {
        "latencies_ms": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "mean_ms": {"type": "number", "exclusiveMinimum": 0},
        "standard_deviation_ms": {"type": "number", "minimum": 0},
        "median_ms": {"type": "number", "exclusiveMinimum": 0},
        "p50_ms": {"type": "number", "exclusiveMinimum": 0},
        "p95_ms": {"type": "number", "exclusiveMinimum": 0},
        "p99_ms": {"type": "number", "exclusiveMinimum": 0},
        "throughput_docs_per_second": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
